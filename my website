*{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#0877e8;--dark:#063d86;--light:#f4f8fd;--border:#cfe0f1;--text:#18324d}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#f7faff;color:var(--text);line-height:1.45}
a{text-decoration:none;color:inherit}
.container{width:min(1180px,94%);margin:auto}

/* HEADER */
.site-header{background:#fff;border-bottom:1px solid #dce7f2}
.top-header{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:25px}
.brand{display:flex;align-items:center;gap:12px}
.brand-logo{.logo 
    width: 120px;
    height: auto;}
.brand h1{font-size:25px;line-height:1;color:#092f63;letter-spacing:.4px}
.brand h1 span{color:#0877e8}
.brand p{font-size:13px;color:#526a83;margin-top:4px}
.header-right{display:flex;flex-direction:column;align-items:flex-end;gap:7px;flex:1}
.mini-links{font-size:12px;color:#445c74}
.search{display:flex;width:min(570px,100%);height:40px}
.search input{flex:1;border:1px solid #cbdced;border-right:0;border-radius:8px 0 0 8px;padding:0 14px;outline:none;background:#fbfdff}
.search button{width:55px;border:0;border-radius:0 8px 8px 0;background:var(--blue);color:#fff;font-size:23px;cursor:pointer}
.main-nav{background:linear-gradient(90deg,#0566d5,#087ef2)}
.nav-inner{display:flex;overflow:auto}
.nav-inner a{color:#fff;padding:12px 14px;font-size:13px;font-weight:700;white-space:nowrap;border-right:1px solid rgba(255,255,255,.12)}
.nav-inner a:hover{background:rgba(0,0,0,.14)}
.menu-btn{display:none;border:0;background:#0877e8;color:#fff;padding:9px 12px;border-radius:6px;font-size:20px}

/* HERO */
.hero{margin-top:18px;display:grid;grid-template-columns:44% 56%;min-height:130px;border-radius:8px;overflow:hidden;box-shadow:0 3px 14px rgba(20,70,120,.12)}
.hero-blue{background:linear-gradient(110deg,#063d86,#0877e8);color:#fff;display:flex;align-items:center;padding:18px 30px;gap:22px}
.hero-emblem{font-size:47px;opacity:.9}
.eyebrow{font-size:12px;font-weight:bold;opacity:.85}
.hero h2{font-size:29px;margin:2px 0}
.hero p{font-size:15px;margin-bottom:10px}
.yellow-btn{display:inline-block;background:#ffd51c;color:#182c45;padding:8px 14px;border-radius:5px;font-size:12px;font-weight:800;box-shadow:0 2px 4px #0002}
.hero-info{position:relative;background:linear-gradient(100deg,#eef8ff,#dceeff);padding:20px 35px;overflow:hidden}
.hero-info p{font-weight:700;color:#163d63;font-size:13px;margin:4px 0}
.hero-info p::first-letter{color:#16a05d}
.hero-art{position:absolute;right:60px;bottom:-15px;font-size:95px;opacity:.16}

/* MAIN LAYOUT */
.layout{display:grid;grid-template-columns:200px minmax(0,1fr) 205px;gap:18px;margin-top:16px;align-items:start}
.side-card{background:#fff;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(22,76,130,.06);margin-bottom:16px}
.side-title{background:linear-gradient(90deg,#0877e8,#0965ca);color:#fff;font-weight:800;padding:10px 12px;font-size:15px}
.side-card>a{display:flex;justify-content:space-between;gap:8px;padding:9px 12px;border-bottom:1px solid #e7eff7;font-size:12px;color:#254562}
.side-card>a:hover{background:#f0f7ff;color:#0069d8}
.side-card>a:last-child{border-bottom:0}
.promo{background:linear-gradient(150deg,#0755ae,#087df0);border-radius:8px;padding:22px 12px;text-align:center;color:#fff;margin-bottom:16px;box-shadow:0 4px 12px #0755ae33}
.promo-icon{font-size:40px;margin-bottom:5px}
.promo h3{font-size:17px;line-height:1.45;margin-bottom:16px}
.social-card .side-title{background:#eaf6ff;color:#0a5db6}
.socials{display:flex;justify-content:center;gap:10px;padding:14px}
.socials a,.footer-socials a{width:32px;height:32px;border-radius:50%;background:#0877e8;color:#fff;display:grid;place-items:center;font-weight:bold}

/* CONTENT */
.section-box{background:#fff;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(22,76,130,.06);margin-bottom:16px}
.section-head{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;color:#fff}
.section-head.blue{background:linear-gradient(90deg,#0877e8,#0761ca)}
.section-head h2{font-size:17px}
.section-head a{font-size:11px;font-weight:bold}
.latest-list a,.latest-item{display:flex;justify-content:space-between;gap:10px;padding:9px 13px;border-bottom:1px solid #e5edf5;font-size:12px}
.latest-item:last-child{border-bottom:0}
.latest-item .date{color:#6d8095;font-size:10px;white-space:nowrap}
.latest-item::before{content:"";width:7px;height:7px;border-radius:50%;background:#f02d3a;display:block;flex:none;margin-top:5px}
.latest-item .title{flex:1}
.card-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.update-card{background:#fff;border:1px solid var(--border);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(22,76,130,.06)}
.card-head{color:#fff;padding:9px 12px;display:flex;justify-content:space-between;align-items:center;font-size:14px;font-weight:800}
.card-head a{font-size:10px}
.blue-card .card-head{background:#0877e8}.green-card .card-head{background:#0a9c72}.orange-card .card-head{background:#ff7c16}.purple-card .card-head{background:#7951e9}.pink-card .card-head{background:#e91e73}.teal-card .card-head{background:#009b8c}.red-card .card-head{background:#ef4352}
.post-list{list-style:none;padding:3px 12px 7px}
.post-list li{padding:7px 0;border-bottom:1px dashed #d7e3ee;font-size:11.5px;cursor:pointer}
.post-list li:last-child{border-bottom:0}
.post-list li:hover{color:#0671df}
.post-list li::before{content:"•";margin-right:7px;font-size:17px;color:#0877e8}
.green-card .post-list li::before{color:#0a9c72}.orange-card .post-list li::before{color:#ff7c16}.purple-card .post-list li::before{color:#7951e9}.pink-card .post-list li::before{color:#e91e73}.teal-card .post-list li::before{color:#009b8c}.red-card .post-list li::before{color:#ef4352}
.about{margin-top:18px;background:linear-gradient(100deg,#e8f5ff,#fff);border:1px solid #b9d9f5;border-radius:9px;padding:18px;display:grid;grid-template-columns:1.5fr 1fr .7fr;gap:20px;align-items:center}
.about h2{font-size:18px;color:#0757a8;margin-bottom:8px}.about p{font-size:12px;color:#425d75}.about-points p{margin:4px 0}.about-slogan{font-size:21px;color:#0757a8;font-style:italic;text-align:center}

/* RIGHT */
.new-badge{float:right;background:#ff263b;color:#fff;border-radius:4px;padding:2px 5px;font-size:9px}
.news-side a{display:block}
.news-side small{display:block;color:#8192a3;margin-top:3px;font-size:9px}
.small-promo{padding:17px 10px}

/* FOOTER */
.footer{margin-top:35px;background:linear-gradient(135deg,#063d86,#075dbb);color:#fff}
.footer-grid{padding:35px 0;display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1.5fr;gap:25px}
.footer-brand{display:flex;gap:12px;align-items:flex-start}.footer-brand .brand-logo{background:#fff;color:#0757a8;border:0;width:50px;height:50px}.footer h2{font-size:20px}.footer h3{font-size:13px;margin-bottom:10px}.footer p,.footer a{font-size:11px;color:#e0edff}.footer a{display:block;margin:6px 0}.footer a:hover{color:#fff}.footer-socials{display:flex;gap:8px}.subscribe{display:flex}.subscribe input{width:100%;border:0;padding:9px;border-radius:5px 0 0 5px;outline:none}.subscribe button{border:0;background:#ffd51c;padding:0 10px;font-weight:bold;border-radius:0 5px 5px 0;cursor:pointer}
.copyright{border-top:1px solid rgba(255,255,255,.15);padding:12px 0;font-size:10px}.copyright .container{display:flex;justify-content:space-between}

/* RESPONSIVE */
@media(max-width:1000px){
  .layout{grid-template-columns:180px minmax(0,1fr)}
  .right-sidebar{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:15px}.right-sidebar>*{margin-bottom:0}
  .footer-grid{grid-template-columns:1fr 1fr 1fr}
}
@media(max-width:760px){
  .top-header{min-height:72px}.header-right{display:none}.menu-btn{display:block}.main-nav{display:none}.main-nav.open{display:block}.nav-inner{display:grid;grid-template-columns:1fr 1fr}
  .nav-inner a{font-size:12px;padding:10px}
  .hero{grid-template-columns:1fr}.hero-info{display:none}.hero-blue{padding:20px}
  .layout{grid-template-columns:1fr}.left-sidebar{order:2}.content{order:1}.right-sidebar{order:3;display:block}
  .card-grid{grid-template-columns:1fr}.about{grid-template-columns:1fr}.about-slogan{text-align:left}
  .left-sidebar{display:grid;grid-template-columns:1fr 1fr;gap:12px}.left-sidebar>*{margin:0}.left-sidebar .side-card:first-child{grid-column:1/-1}
  .footer-grid{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}
}
@media(max-width:480px){
  .container{width:94%}.brand h1{font-size:20px}.brand p{font-size:10px}.brand-logo{width:48px;height:48px;font-size:18px}
  .hero h2{font-size:24px}.hero-emblem{font-size:35px}.hero-blue{gap:12px}
  .left-sidebar{grid-template-columns:1fr}.left-sidebar .side-card:first-child{grid-column:auto}
  .footer-grid{grid-template-columns:1fr}.copyright .container{display:block}.copyright span{display:block;margin:3px 0}
}

