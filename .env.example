# Node.js email notifier only; configure PHP with the CJ_* variables in Render
# or with backend/config.local.php for local development.
PORT=4000
SENDGRID_API_KEY=replace_with_your_sendgrid_api_key
SENDGRID_FROM_EMAIL=verified-sender@example.com
EMAIL_NOTIFICATION_TOKEN=CHANGE_THIS_TO_THE_SAME_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SITE_NAME=Cyber Junction
